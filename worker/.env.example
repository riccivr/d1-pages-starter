# Turso Database Configuration
# Obtain from: turso db show <db-name> --url
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io

# Obtain from: turso db tokens create <db-name>
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token-here

# Allowed Origin for CORS (e.g. https://yourusername.github.io or * for development)
ALLOWED_ORIGIN=*

# Optional Admin Key (to protect DELETE operations if desired)
ADMIN_API_KEY=your-secret-admin-key
