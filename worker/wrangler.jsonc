{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "d1-pages-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Allowed CORS origin. In production, set to your GitHub Pages URL e.g. "https://<user>.github.io"
    // Use "*" for development or public APIs.
    "ALLOWED_ORIGIN": "*"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pages-d1-db",
      // Replace with your database_id generated by: npx wrangler d1 create pages-d1-db
      "database_id": "YOUR_DATABASE_ID_HERE"
    }
  ]
}
