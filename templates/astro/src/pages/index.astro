---
import Layout from "../layouts/Layout.astro";
import Guestbook from "../components/Guestbook.astro";
---

<Layout title="Turso Pages Starter - Astro">
  <main class="page-container">
    <header>
      <div class="badge">Astro + Turso + Cloudflare</div>
      <h1>Turso Pages Starter (Astro)</h1>
      <p class="desc">A lightweight, lightning-fast static site deployed on GitHub Pages communicating with Turso database via Cloudflare edge proxy.</p>
    </header>

    <Guestbook />
  </main>
</Layout>

<style>
  .page-container {
    max-width: 700px;
    margin: 0 auto;
    padding: 3rem 1.25rem;
  }
  header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 9999px;
    margin-bottom: 1rem;
  }
  h1 {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }
  .desc {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
