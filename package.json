{
  "name": "d1-pages-starter",
  "version": "1.0.0",
  "description": "Baseline starter kit for connecting GitHub Pages with Cloudflare D1 SQLite via Cloudflare Workers",
  "private": true,
  "scripts": {
    "dev:worker": "npm --prefix worker run dev",
    "deploy:worker": "npm --prefix worker run deploy",
    "db:init:local": "npm --prefix worker run db:init:local",
    "db:init:remote": "npm --prefix worker run db:init:remote",
    "dev:react": "npm --prefix templates/react run dev",
    "build:react": "npm --prefix templates/react run build",
    "dev:astro": "npm --prefix templates/astro run dev",
    "build:astro": "npm --prefix templates/astro run build",
    "dev:svelte": "npm --prefix templates/svelte run dev",
    "build:svelte": "npm --prefix templates/svelte run build"
  },
  "keywords": [
    "cloudflare-d1",
    "github-pages",
    "cloudflare-workers",
    "starter",
    "sqlite",
    "serverless",
    "free-tier"
  ],
  "author": "",
  "license": "MIT"
}
